{
  "name": "vis-dev-utils",
  "version": "0.0.0-no-version",
  "description": "Development utilities for the Vis family projects.",
  "keywords": [
    "development",
    "utils",
    "vis"
  ],
  "homepage": "http://visjs.org/",
  "bugs": {
    "url": "https://github.com/visjs/vis-dev-utils/issues"
  },
  "license": "(Apache-2.0 OR MIT)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visjs/vis-dev-utils.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/visjs"
  },
  "bin": {
    "ci-utils": "bin/ci-utils.js",
    "generate-examples-index": "bin/generate-examples-index.js",
    "test-e2e-interop": "bin/test-e2e-interop.js"
  },
  "files": [
    "LICENSE*",
    "README.md",
    "babel-preset",
    "bin",
    "declarations",
    "dist",
    "oxfmt-shared-config",
    "oxlint-shared-config"
  ],
  "type": "module",
  "main": "dist/vis-dev-utils.cjs",
  "module": "dist/vis-dev-utils.mjs",
  "types": "declarations/module/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vis-dev-utils.mjs",
      "require": "./dist/vis-dev-utils.cjs",
      "types": "./declarations/module/index.d.ts"
    },
    "./babel-preset": {
      "import": "./babel-preset/index.mjs",
      "require": "./babel-preset/index.cjs",
      "types": "./declarations/babel-preset/index.d.ts"
    },
    "./dist/interop/base-config.json": {
      "import": "./dist/interop/base-config.json",
      "require": "./dist/interop/base-config.json"
    },
    "./oxfmt-shared-config": {
      "import": "./oxfmt-shared-config/index.mjs",
      "require": "./oxfmt-shared-config/index.cjs",
      "types": "./declarations/oxfmt-shared-config/index.d.ts"
    },
    "./oxlint-shared-config": {
      "import": "./oxlint-shared-config/index.mjs",
      "require": "./oxlint-shared-config/index.cjs",
      "types": "./declarations/oxlint-shared-config/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run build:production && npm run build:declarations",
    "build:declarations": "npx tsc --project tsconfig.declarations.json",
    "build:production": "rollup --config ./rollup.config.js",
    "clean": "shx rm -rf \"./{.nyc_output,.rpt2_cache}\" \"./{babel-preset,bin,coverage,declarations,dist,e2e,gen,oxfmt-shared-config,oxlint-shared-config}/*\"",
    "style": "oxfmt --check .",
    "style-fix": "oxfmt .",
    "lint": "oxlint --report-unused-disable-directives-severity error .",
    "lint-fix": "oxlint --report-unused-disable-directives-severity error --fix .",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit && npm run test:interop",
    "test:interop": "node interop.js",
    "test:interop:debug": "npm run test:interop -- --fail-command \"$SHELL\"",
    "test:unit": "mocha --exit",
    "watch": "rollup --watch --config rollup.config.js",
    "prepare": "husky"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "find-up": "8.0.0",
    "fs-extra": "11.4.0",
    "globby": "16.2.4",
    "jimp": "1.6.1",
    "oxfmt": "0.63.0",
    "tmp": "0.2.3",
    "yargs": "18.1.0"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/chai": "5.2.3",
    "@types/cheerio": "1.0.0",
    "@types/mocha": "10.0.10",
    "@types/puppeteer": "7.0.4",
    "@types/sinon": "22.0.0",
    "@types/tmp": "0.2.6",
    "@types/yargs": "17.0.35",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "mocha": "12.0.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "9.0.1",
    "shx": "0.4.0",
    "sinon": "22.1.0",
    "snap-shot-it": "7.9.10"
  },
  "peerDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/runtime-corejs3": "7.29.7",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "babel-plugin-istanbul": "8.0.0",
    "chai": "6.2.2",
    "postcss-assets": "6.0.0",
    "puppeteer": "25.9.0",
    "rollup": "4.44.2",
    "rollup-plugin-analyzer": "4.0.0",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-string": "3.0.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,css,html,json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity error --fix",
    ".*.{js,ts,css,html,json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern",
    ".*.{js,ts}": "oxlint --no-error-on-unmatched-pattern --report-unused-disable-directives-severity error --fix"
  },
  "config": {
    "snap-shot-it": {
      "sortSnapshots": true,
      "useRelativePath": true
    }
  }
}
