{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "declarations",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src"
  },
  "exclude": ["node_modules", "**/__tests__/*"],
  "include": ["@types", "src"]
}
